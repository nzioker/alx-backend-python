#!/bin/bash

# Rolling Update Script for Django Messaging App
# This script performs rolling updates with zero downtime

set -e

echo "========================================"
echo "Rolling Update - Zero Downtime Deployment"
echo "========================================"

# Variables
DEPLOYMENT_NAME="django-messaging-app-blue"
NAMESPACE="messaging-app"
TEST_URL="http://localhost:8080"
MAX_RETRIES=30
RETRY_INTERVAL=5

# Function to check prerequisites
check_prerequisites() {
    echo "Checking prerequisites..."
    
    # Check kubectl
    if ! command -v kubectl >/dev/null 2>&1; then
        echo "ERROR: kubectl not found. Please install kubectl first."
        exit 1
    fi
    
    # Check if deployment exists
    if ! kubectl get deployment $DEPLOYMENT_NAME -n $NAMESPACE >/dev/null 2>&1; then
        echo "ERROR: Deployment $DEPLOYMENT_NAME not found in namespace $NAMESPACE"
        exit 1
    fi
    
    echo "✓ All prerequisites met"
}

# Function to start background monitoring
start_background_monitor() {
    echo -e "\nStarting background monitoring..."
    
    # Monitor pods in background
    (
        while true; do
            clear
            echo "=== Pod Status Monitor ==="
            kubectl get pods -n $NAMESPACE -l app=django-messaging -o wide
            echo -e "\n=== Deployment Status ==="
            kubectl get deployment $DEPLOYMENT_NAME -n $NAMESPACE
            sleep 2
        done
    ) &
    MONITOR_PID=$!
    
    # Trap to kill monitor on script exit
    trap "kill $MONITOR_PID 2>/dev/null" EXIT
}

# Function to apply rolling update
apply_rolling_update() {
    echo -e "\nApplying rolling update to version 2.0..."
    
    # Get current deployment details
    echo "Current deployment status:"
    kubectl get deployment $DEPLOYMENT_NAME -n $NAMESPACE -o jsonpath='{"Image: "}{.spec.template.spec.containers[0].image}{"\nReplicas: "}{.spec.replicas}{"\n"}'
    
    # Apply the updated deployment
    echo "Applying updated deployment configuration..."
    kubectl apply -f blue_deployment.yaml
    
    # Start rollout status monitoring
    echo -e "\nMonitoring rollout status..."
    kubectl rollout status deployment/$DEPLOYMENT_NAME -n $NAMESPACE --timeout=300s
    
    if [ $? -eq 0 ]; then
        echo "✓ Rolling update completed successfully"
    else
        echo "✗ Rolling update failed"
        echo "Checking rollout history..."
        kubectl rollout history deployment/$DEPLOYMENT_NAME -n $NAMESPACE
        exit 1
    fi
}

# Function to continuously test application
continuous_application_test() {
    echo -e "\nStarting continuous application testing..."
    
    # Port forward to access the application
    echo "Setting up port forwarding..."
    kubectl port-forward -n $NAMESPACE service/messaging-service 8080:80 &
    PORT_FORWARD_PID=$!
    
    # Wait for port forward to be ready
    sleep 5
    
    # Test counter
    TEST_COUNT=0
    FAIL_COUNT=0
    START_TIME=$(date +%s)
    
    echo "Testing application continuously during update..."
    echo "Press Ctrl+C to stop testing"
    
    # Continuous testing loop
    while true; do
        ((TEST_COUNT++))
        
        # Send request and measure response time
        START_REQUEST=$(date +%s%N)
        RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" -m 5 "$TEST_URL/health/" || echo "000")
        END_REQUEST=$(date +%s%N)
        
        RESPONSE_TIME=$((($END_REQUEST - $START_REQUEST) / 1000000))  # Convert to milliseconds
        
        # Check response
        if [ "$RESPONSE" = "200" ]; then
            STATUS="✓"
        else
            STATUS="✗"
            ((FAIL_COUNT++))
        fi
        
        # Calculate uptime percentage
        CURRENT_TIME=$(date +%s)
        ELAPSED_TIME=$((CURRENT_TIME - START_TIME))
        if [ $ELAPSED_TIME -gt 0 ]; then
            UPTIME_PERCENT=$((100 * (TEST_COUNT - FAIL_COUNT) / TEST_COUNT))
        else
            UPTIME_PERCENT=100
        fi
        
        # Display status
        printf "\rTest #%04d | HTTP %s | Time: %4dms | Uptime: %3d%% | %s" \
            $TEST_COUNT $RESPONSE $RESPONSE_TIME $UPTIME_PERCENT "$(date +%H:%M:%S)"
        
        # Check if update is complete
        UPDATED_PODS=$(kubectl get pods -n $NAMESPACE -l app=django-messaging -o jsonpath='{.items[*].spec.containers[0].image}' | grep -c "2.0" || true)
        TOTAL_PODS=$(kubectl get pods -n $NAMESPACE -l app=django-messaging --no-headers | wc -l | tr -d ' ')
        
        if [ "$UPDATED_PODS" -eq "$TOTAL_PODS" ] && [ "$TOTAL_PODS" -gt 0 ]; then
            echo -e "\n\n✓ All pods updated to version 2.0"
            break
        fi
        
        sleep 1
    done
    
    # Kill port forward
    kill $PORT_FORWARD_PID 2>/dev/null
    
    # Final statistics
    echo -e "\n=== Testing Statistics ==="
    echo "Total tests: $TEST_COUNT"
    echo "Failed tests: $FAIL_COUNT"
    echo "Success rate: $((100 * (TEST_COUNT - FAIL_COUNT) / TEST_COUNT))%"
    
    if [ $FAIL_COUNT -eq 0 ]; then
        echo "✓ Zero downtime maintained during rolling update"
    else
        echo "⚠ Some failures occurred during update"
    fi
}

# Function to verify update completion
verify_update_completion() {
    echo -e "\nVerifying update completion..."
    
    # Check deployment status
    echo "1. Deployment status:"
    kubectl get deployment $DEPLOYMENT_NAME -n $NAMESPACE
    
    # Check pods
    echo -e "\n2. Pod status:"
    kubectl get pods -n $NAMESPACE -l app=django-messaging -o wide
    
    # Check image versions
    echo -e "\n3. Image versions:"
    kubectl get pods -n $NAMESPACE -l app=django-messaging -o jsonpath='{range .items[*]}{.metadata.name}{": "}{.spec.containers[0].image}{"\n"}{end}'
    
    # Verify all pods are running version 2.0
    OLD_VERSION_PODS=$(kubectl get pods -n $NAMESPACE -l app=django-messaging -o jsonpath='{.items[*].spec.containers[0].image}' | grep -c "1.0" || true)
    
    if [ "$OLD_VERSION_PODS" -eq 0 ]; then
        echo "✓ All pods successfully updated to version 2.0"
    else
        echo "✗ Some pods still running old version"
        exit 1
    fi
    
    # Check rollout history
    echo -e "\n4. Rollout history:"
    kubectl rollout history deployment/$DEPLOYMENT_NAME -n $NAMESPACE
}

# Function to perform post-update tests
post_update_tests() {
    echo -e "\nPerforming post-update tests..."
    
    # Port forward for testing
    kubectl port-forward -n $NAMESPACE service/messaging-service 8081:80 &
    PF_PID=$!
    sleep 3
    
    # Test endpoints
    echo "1. Health check:"
    curl -s "$TEST_URL/health/" | head -2
    
    echo -e "\n2. API endpoint test:"
    curl -s "$TEST_URL/api/messages/" -o /dev/null -w "Status: %{http_code}\n"
    
    echo -e "\n3. Version check:"
    VERSION=$(curl -s "$TEST_URL/health/" | grep -o '"version":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
    echo "Application version: $VERSION"
    
    # Kill port forward
    kill $PF_PID 2>/dev/null
    
    if [ "$VERSION" = "2.0-blue" ]; then
        echo "✓ Version 2.0 confirmed"
    else
        echo "✗ Version mismatch"
    fi
}

# Function to rollback if needed
setup_rollback() {
    echo -e "\nSetting up rollback capability..."
    
    # Create rollback script
    cat > /tmp/rollback_script.sh << 'EOF'
#!/bin/bash
echo "Initiating rollback..."
kubectl rollout undo deployment/django-messaging-app-blue -n messaging-app
kubectl rollout status deployment/django-messaging-app-blue -n messaging-app --timeout=180s
echo "Rollback completed"
EOF
    
    chmod +x /tmp/rollback_script.sh
    
    echo "Rollback script created at: /tmp/rollback_script.sh"
    echo "To rollback, run: /tmp/rollback_script.sh"
}

# Main execution
main() {
    echo "Starting rolling update process..."
    
    # Check prerequisites
    check_prerequisites
    
    # Start background monitoring
    start_background_monitor
    sleep 2
    
    # Setup rollback capability
    setup_rollback
    
    # Apply rolling update
    apply_rolling_update
    
    # Continuous testing during update
    continuous_application_test
    
    # Verify update completion
    verify_update_completion
    
    # Post-update tests
    post_update_tests
    
    echo -e "\n========================================"
    echo "Rolling Update Successfully Completed!"
    echo "========================================"
    echo "Summary:"
    echo "- Zero downtime maintained"
    echo "- All pods updated to version 2.0"
    echo "- Application fully functional"
    echo "- Rollback script available if needed"
    echo "========================================"
}

# Run main function
main
