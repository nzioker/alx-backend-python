pipeline {
    agent any
    
    environment {
        // Docker Hub credentials (configure in Jenkins credentials)
        DOCKER_REGISTRY = credentials('docker-hub-credentials')
        DOCKER_IMAGE = 'yourusername/messaging-app'
        DOCKER_TAG = "${BUILD_NUMBER}"
        
        // GitHub credentials (configure in Jenkins credentials)
        GITHUB_CREDENTIALS = credentials('github-credentials')
        
        // Python environment
        PYTHON_VERSION = '3.9'
        VENV_PATH = 'venv'
        PROJECT_PATH = 'messaging_app'
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }
    
    stages {
        stage('Checkout') {
            steps {
                // Checkout code from GitHub
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    extensions: [],
                    userRemoteConfigs: [[
                        url: 'https://github.com/yourusername/alx-backend-python.git',
                        credentialsId: 'github-credentials'
                    ]]
                ])
                
                // Print current directory and branch
                sh 'pwd'
                sh 'ls -la'
                sh 'git branch'
                sh 'git log --oneline -5'
            }
        }
        
        stage('Setup Python Environment') {
            steps {
                script {
                    // Setup Python virtual environment
                    sh """
                    python${PYTHON_VERSION} -m venv ${VENV_PATH}
                    . ${VENV_PATH}/bin/activate
                    python --version
                    pip3 --version
                    """
                }
            }
        }
        
        stage('Install Dependencies') {
            steps {
                script {
                    // Check if requirements.txt exists
                    sh """
                    echo "Checking for requirements files..."
                    ls -la ${PROJECT_PATH}/
                    
                    if [ -f "${PROJECT_PATH}/requirements.txt" ]; then
                        echo "Found ${PROJECT_PATH}/requirements.txt"
                    else
                        echo "Warning: ${PROJECT_PATH}/requirements.txt not found"
                    fi
                    """
                    
                    // Install dependencies using pip3
                    sh """
                    . ${VENV_PATH}/bin/activate
                    
                    echo "Installing dependencies..."
                    
                    # Install from messaging_app/requirements.txt
                    if [ -f "${PROJECT_PATH}/requirements.txt" ]; then
                        pip3 install --upgrade pip
                        pip3 install -r ${PROJECT_PATH}/requirements.txt
                    else
                        # Fallback: install basic Django dependencies
                        pip3 install django djangorestframework django-cors-headers
                    fi
                    
                    # Install test dependencies
                    pip3 install pytest pytest-django pytest-cov pytest-html
                    pip3 install flake8 black bandit safety
                    
                    # List installed packages
                    pip3 freeze
                    """
                }
            }
        }
        
        stage('Code Quality Checks') {
            steps {
                script {
                    sh """
                    . ${VENV_PATH}/bin/activate
                    
                    echo "Running code quality checks..."
                    
                    # Run flake8 for linting
                    echo "=== Running flake8 ==="
                    flake8 ${PROJECT_PATH}/ --count --select=E9,F63,F7,F82 --show-source --statistics
                    flake8 ${PROJECT_PATH}/ --count --exit-zero --max-complexity=10 --max-line-length=127 --statistics
                    
                    # Run black for code formatting check
                    echo "=== Running black check ==="
                    black --check ${PROJECT_PATH}/ || echo "Black check completed"
                    
                    # Run bandit for security
                    echo "=== Running bandit security scan ==="
                    bandit -r ${PROJECT_PATH}/ -f json -o bandit-report.json || echo "Bandit scan completed"
                    """
                }
            }
            post {
                always {
                    // Archive security report
                    archiveArtifacts artifacts: 'bandit-report.json', fingerprint: true
                }
            }
        }
        
        stage('Run Tests with pytest') {
            steps {
                script {
                    // Run Django tests with pytest
                    sh """
                    . ${VENV_PATH}/bin/activate
                    
                    echo "Setting up Django environment..."
                    
                    # Set Django settings module
                    export DJANGO_SETTINGS_MODULE=${PROJECT_PATH}.settings
                    export PYTHONPATH=\${PYTHONPATH}:${PROJECT_PATH}
                    
                    echo "DJANGO_SETTINGS_MODULE: \${DJANGO_SETTINGS_MODULE}"
                    echo "PYTHONPATH: \${PYTHONPATH}"
                    
                    # Change to project directory
                    cd ${PROJECT_PATH}
                    
                    # Run pytest with coverage
                    echo "=== Running tests with pytest ==="
                    pytest . \
                        --cov=. \
                        --cov-report=xml:../coverage.xml \
                        --cov-report=html:../coverage_html \
                        --cov-report=term \
                        -v \
                        --junitxml=../test-results.xml \
                        --html=../test-report.html \
                        --self-contained-html
                    
                    # Also run Django tests directly as backup
                    echo "=== Running Django tests directly ==="
                    python manage.py test --verbosity=2 || echo "Django tests completed"
                    
                    # Go back to root directory
                    cd ..
                    """
                }
            }
            post {
                always {
                    // Archive test results
                    junit 'test-results.xml'
                    
                    // Archive HTML test report
                    publishHTML([
                        reportDir: '.',
                        reportFiles: 'test-report.html',
                        reportName: 'Pytest HTML Report',
                        keepAll: true
                    ])
                    
                    // Archive coverage report
                    publishHTML([
                        reportDir: 'coverage_html',
                        reportFiles: 'index.html',
                        reportName: 'Coverage Report',
                        keepAll: true
                    ])
                    
                    // Archive artifacts
                    archiveArtifacts artifacts: 'test-results.xml', fingerprint: true
                    archiveArtifacts artifacts: 'coverage.xml', fingerprint: true
                }
                failure {
                    echo 'Tests failed!'
                }
            }
        }
        
        stage('Generate Test Report') {
            steps {
                script {
                    // Generate comprehensive test report
                    sh """
                    . ${VENV_PATH}/bin/activate
                    
                    echo "=== GENERATING TEST REPORT ==="
                    
                    # Create detailed test summary
                    cat > test-summary.txt << EOF
                    JENKINS TEST REPORT
                    ====================
                    
                    Project: Django Messaging App
                    Build Number: ${BUILD_NUMBER}
                    Build URL: ${BUILD_URL}
                    Timestamp: $(date)
                    
                    GIT INFORMATION
                    ---------------
                    Repository: https://github.com/yourusername/alx-backend-python.git
                    Branch: $(git branch --show-current)
                    Commit: $(git log --oneline -1)
                    
                    ENVIRONMENT
                    -----------
                    Python Version: $(python --version)
                    Django Version: $(python -c "import django; print(django.get_version())")
                    Pip Version: $(pip3 --version | cut -d' ' -f2)
                    
                    TEST RESULTS
                    ------------
                    EOF
                    
                    # Extract test results from XML
                    if [ -f test-results.xml ]; then
                        echo "Extracting test results..."
                        
                        # Count tests
                        TOTAL_TESTS=\$(grep -o 'tests=\"[0-9]*\"' test-results.xml | head -1 | grep -o '[0-9]*')
                        FAILED_TESTS=\$(grep -o 'failures=\"[0-9]*\"' test-results.xml | head -1 | grep -o '[0-9]*')
                        ERROR_TESTS=\$(grep -o 'errors=\"[0-9]*\"' test-results.xml | head -1 | grep -o '[0-9]*')
                        SKIPPED_TESTS=\$(grep -o 'skipped=\"[0-9]*\"' test-results.xml | head -1 | grep -o '[0-9]*')
                        
                        cat >> test-summary.txt << EOF
                        Total Tests: \${TOTAL_TESTS}
                        Failed: \${FAILED_TESTS}
                        Errors: \${ERROR_TESTS}
                        Skipped: \${SKIPPED_TESTS}
                        Success Rate: \$(( (TOTAL_TESTS - FAILED_TESTS - ERROR_TESTS) * 100 / TOTAL_TESTS ))% 
                        
                        EOF
                    else
                        echo "No test results found" >> test-summary.txt
                    fi
                    
                    # Extract coverage results
                    if [ -f coverage.xml ]; then
                        echo "Extracting coverage results..."
                        
                        LINE_COVERAGE=\$(grep -o 'line-rate=\"[0-9.]*\"' coverage.xml | head -1 | grep -o '[0-9.]*')
                        BRANCH_COVERAGE=\$(grep -o 'branch-rate=\"[0-9.]*\"' coverage.xml | head -1 | grep -o '[0-9.]*')
                        
                        cat >> test-summary.txt << EOF
                        COVERAGE REPORT
                        ---------------
                        Line Coverage: \${LINE_COVERAGE}
                        Branch Coverage: \${BRANCH_COVERAGE}
                        
                        EOF
                    fi
                    
                    # List test files
                    echo "TEST FILES" >> test-summary.txt
                    echo "----------" >> test-summary.txt
                    find ${PROJECT_PATH} -name "*test*.py" -o -name "tests.py" | sort >> test-summary.txt
                    
                    # Display the report
                    echo "=== TEST REPORT SUMMARY ==="
                    cat test-summary.txt
                    """
                }
            }
            post {
                always {
                    // Archive test summary
                    archiveArtifacts artifacts: 'test-summary.txt', fingerprint: true
                    
                    // Publish coverage report
                    publishCoverage(
                        adapters: [jacocoAdapter('coverage.xml')],
                        sourceFileResolver: sourceFiles('STORE_LAST_BUILD')
                    )
                    
                    // Generate badge
                    script {
                        if (currentBuild.currentResult == 'SUCCESS') {
                            sh 'echo "![Build Status](https://img.shields.io/badge/build-passing-brightgreen.svg)" > build-status.md'
                        } else {
                            sh 'echo "![Build Status](https://img.shields.io/badge/build-failing-red.svg)" > build-status.md'
                        }
                        archiveArtifacts artifacts: 'build-status.md', fingerprint: true
                    }
                }
            }
        }
        
        stage('Build Artifacts') {
            steps {
                script {
                    // Create deployment artifacts
                    sh """
                    echo "Creating build artifacts..."
                    
                    # Create requirements.txt if it doesn't exist
                    if [ ! -f "${PROJECT_PATH}/requirements.txt" ]; then
                        echo "Creating requirements.txt..."
                        . ${VENV_PATH}/bin/activate
                        pip3 freeze > ${PROJECT_PATH}/requirements.txt
                    fi
                    
                    # Create build archive
                    tar -czf messaging-app-build-\${BUILD_NUMBER}.tar.gz \
                        ${PROJECT_PATH}/ \
                        test-summary.txt \
                        test-results.xml \
                        coverage.xml \
                        bandit-report.json
                    
                    # List created artifacts
                    ls -la *.tar.gz
                    """
                }
            }
            post {
                always {
                    // Archive build artifacts
                    archiveArtifacts artifacts: '*.tar.gz', fingerprint: true
                }
            }
        }
    }
    
    post {
        always {
            echo "=== PIPELINE COMPLETION ==="
            echo "Build ${BUILD_NUMBER} - Status: ${currentBuild.currentResult}"
            echo "Build URL: ${BUILD_URL}"
            
            // Clean up
            sh """
            echo "Cleaning up..."
            rm -rf ${VENV_PATH} || true
            rm -rf coverage_html || true
            rm -f test-report.html || true
            """
        }
        success {
            echo ' Pipeline completed successfully!'
            
            // Update build status
            currentBuild.description = "SUCCESS - Build ${BUILD_NUMBER}"
        }
        failure {
            echo ' Pipeline failed!'
            currentBuild.description = "FAILED - Build ${BUILD_NUMBER}"
        }
        unstable {
            echo ' Pipeline is unstable!'
            currentBuild.description = "UNSTABLE - Build ${BUILD_NUMBER}"
        }
        aborted {
            echo ' Pipeline was aborted!'
            currentBuild.description = "ABORTED - Build ${BUILD_NUMBER}"
        }
    }
}
